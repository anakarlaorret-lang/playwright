{
  "name": "playwright",
  "version": "1.0.0",
  "description": "Playwright and TypeScript portfolio framework for Movelo UI and Toolshop API testing.",
  "main": "index.js",
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "playwright": "^1.51.1",
    "playwright-core": "^1.51.1",
    "undici-types": "^6.20.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "playwright-bdd": "9.2.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "npx tsc",
    "bdd:generate": "bddgen",
    "test": "npm run bdd:generate && playwright test --project=chromium --project=gherkin",
    "test:parallel-check": "npm run bdd:generate && playwright test --fully-parallel --project=chromium --project=gherkin --workers=2 --retries=0",
    "test:cross-browser": "playwright test --project=firefox --project=webkit tests/homepage.spec.ts",
    "test:gherkin": "npm run bdd:generate && playwright test --project=gherkin",
    "report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anakarlaorret-lang/playwright.git"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "e2e",
    "qa"
  ],
  "author": "Ana K. Orret",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/anakarlaorret-lang/playwright/issues"
  },
  "homepage": "https://github.com/anakarlaorret-lang/playwright#readme"
}
